# Copia este archivo como .env y ajusta los datos de tu servidor MySQL.
MYSQL_DATABASE=tostado_cafeteria
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60
DATABASE_URL=

# Desarrollo local. Para producción, usa DEBUG=False, una clave secreta segura,
# dominios explícitos y orígenes HTTPS en DJANGO_CSRF_TRUSTED_ORIGINS.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=
