# SQLite es la opción predeterminada para usar el proyecto sin instalar MySQL.
# Cambia DATABASE_ENGINE=mysql si quieres usar el servidor MySQL configurado abajo.
DATABASE_ENGINE=sqlite
SQLITE_DATABASE=db.sqlite3

# Configuración opcional para MySQL.
MYSQL_DATABASE=tostado_cafeteria
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60
DATABASE_URL=

# Desarrollo local. Para producción, usa DEBUG=False, una clave secreta segura,
# dominios explícitos y orígenes HTTPS en DJANGO_CSRF_TRUSTED_ORIGINS.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=
